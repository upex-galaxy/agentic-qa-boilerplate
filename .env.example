# ============================================
# KATA Architecture - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# Note: Bun loads .env automatically - no dotenv needed
#
# Variables are validated at startup by validateEnv.ts
# Only variables for current TEST_ENV are required.
# ============================================

# ============================================
# ENVIRONMENT SELECTION
# ============================================
# Which environment to test against
# Valid: local, staging
TEST_ENV=local

# ============================================
# TEST USER CREDENTIALS (Required per environment)
# ============================================
# Only credentials for your current TEST_ENV are validated.
# The other environment's credentials can be left empty.

# --- For TEST_ENV=local ---
LOCAL_USER_EMAIL=
LOCAL_USER_PASSWORD=

# --- For TEST_ENV=staging ---
STAGING_USER_EMAIL=
STAGING_USER_PASSWORD=

# ============================================
# BROWSER CONFIGURATION (Optional)
# ============================================
# Uncomment to override defaults

# HEADLESS=true
# DEFAULT_TIMEOUT=30000

# ============================================
# TMS CONFIGURATION (Optional)
# ============================================
# TMS_PROVIDER=xray
# AUTO_SYNC=false

# --- Xray Cloud (required only if TMS_PROVIDER=xray AND AUTO_SYNC=true) ---
# XRAY_CLIENT_ID=
# XRAY_CLIENT_SECRET=
# XRAY_PROJECT_KEY=PROJECT

# --- Jira Direct (required only if TMS_PROVIDER=jira AND AUTO_SYNC=true) ---
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USER=your-email@example.com
# JIRA_API_TOKEN=
# JIRA_TEST_STATUS_FIELD=customfield_10100

# --- Atlassian (Jira) credentials for acli / Atlassian MCP ---
# Single source of truth. .mcp.json maps these to mcp-atlassian's internal
# JIRA_URL / JIRA_USERNAME / JIRA_API_TOKEN keys, so no duplication needed.
ATLASSIAN_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ============================================
# AI AGENT MCP SERVERS
# ============================================
# .mcp.json (Claude Code) and opencode.jsonc are committed to git and reference
# secrets via env-var expansion:
#   - .mcp.json    → ${VAR_NAME} / ${VAR:-default}   (FAILS on missing var)
#   - opencode.jsonc → {env:VAR_NAME}                (empty string on missing)
#
# Two ways to load these vars before launching the agent:
#
#   A) Cross-platform wrapper (default, works on Windows / Mac / Linux):
#        bun run claude     # wraps `claude` with dotenv-cli
#        bun run opencode   # idem
#
#   B) Optional, Mac/Linux only: direnv auto-loads on `cd` into the repo.
#      See .envrc for the one-time setup. Then run `claude` / `opencode` directly.

# Tavily (web search MCP) — https://app.tavily.com/
TAVILY_API_KEY=

# OpenAPI MCP — backend API exploration
API_BASE_URL=
OPENAPI_SPEC_PATH=
# Auto-populated by `bun run api:login` (rewrites this line in your local .env).
# After login, RESTART your terminal so MCP servers pick up the new value.
API_TOKEN=

# Postman MCP — collection runner (https://postman.com → workspace → API key)
POSTMAN_API_KEY=

# ============================================
# REPORTING (Optional)
# ============================================
# ALLURE_RESULTS_DIR=./allure-results
# SCREENSHOT_ON_FAILURE=true
# VIDEO_ON_FAILURE=true

# ============================================
# CI/CD VARIABLES (Set automatically, NOT here)
# ============================================
# CI=true          (set by GitHub Actions)
# BUILD_ID=<id>    (set by GitHub Actions)
