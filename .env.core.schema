# ============================================================================
# .env.core.schema - GENERATED from cli/lib/variables-manifest.ts. DO NOT EDIT.
# ============================================================================
# SYNCED by the boilerplate updater (component env-schema). Regenerate with
#   bun run vars:schema        and gate it with    bun run vars:schema:check
# Imported by the project-owned .env.schema, which holds the root
# decorators (current env, type generation) and the project's own variables.
#
# This file declares NAMES, types, sensitivity and which items varlock refuses
# to run without. It never holds a value: fill .env (or .env.local), or let a
# provider resolve the sensitive ones. Validate: bunx varlock load --agent
#
# The two root decorators below are the defaults for THIS file's items; each
# item states its own requiredness and sensitivity explicitly.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# ----------------------------------------------------------------------------
# FRAMEWORK (scope: core). What the boilerplate itself reads. The only item
# varlock refuses to run without is TEST_ENV, and it has a default; the rest
# sit behind a feature switch and are validated by the code path behind it.
# Source: cli/lib/variables-manifest.ts. Order = manifest order.
# ----------------------------------------------------------------------------

# Which environment to test against. CI env INPUT, not a secret. Has a default, so it never blocks; an undeclared value fails by name at the envDataMap lookup. Installer writes the default; never prompts.
# Used by: config/variables.core.ts (env.current); config/variables.ts envDataMap; scripts/api-login; CI env input
# Obtain: defaults to local; reconfigure manually or via the /adapt-framework skill when you adapt the framework to your project-under-test.
# @required @type=enum(local, staging)
TEST_ENV=local

# Xray Cloud client id. Referenced by regression.yml §env; optional (needed only when AUTO_SYNC && xray).
# Used by: tests/utils/jiraSync (write-back); bun xray auth; sync-jira-issues enrich (only when the tms-xray switch is on)
# Obtain: Xray Cloud → API keys (only if your project uses Xray TMS).
# @sensitive @docs(https://docs.getxray.app/display/XRAYCLOUD/Global+Settings%3A+API+Keys)
XRAY_CLIENT_ID=

# Xray Cloud client secret. Referenced by regression.yml §env; optional (needed only when AUTO_SYNC && xray).
# Used by: tests/utils/jiraSync (write-back); bun xray auth; sync-jira-issues enrich (only when the tms-xray switch is on)
# Obtain: Xray Cloud → API keys (only if your project uses Xray TMS).
# @sensitive
XRAY_CLIENT_SECRET=

# Xray project key. Optional operational param.
# Used by: config.tms.xray.projectKey (tests/utils/jiraSync) (only when the tms-xray switch is on)
# Obtain: your Xray project key (only if your project uses Xray TMS).
XRAY_PROJECT_KEY=

# The Test Execution this run imports into: the RTR by default, the sprint-close STR at sprint close (never a Plan key). Overridden per dispatch by execution_key; referenced by regression.yml; Xray-only, optional.
# Used by: config.tms.stpExecutionKey (tests/utils/jiraSync); regression.yml execution_key fallback (only when the tms-xray switch is on)
# Obtain: key of the Test Execution this run imports into: the RTR (created by /regression-testing per run, linked to the RTP) by default, the sprint-close STR at sprint close. Both hang off the "QA Test Artifacts" epic. NEVER the key of a Plan (RTP or STP).
STP_EXECUTION_KEY=

# Optional RTP key so the in-process Xray fallback links the Execution it mints to the plan. Local-only; no workflow reads it.
# Used by: config.tms.rtpKey (tests/utils/jiraSync fallback only) (only when the tms-xray switch is on)
# Obtain: key of the RTP (Test Plan titled "RTP: <PROJECT>: Regression Test Plan"): only if you run bun run test:sync locally without an execution key.
RTP_KEY=

# CI operational flag (default false). Referenced by regression.yml §env. GitHub-only.
# Used by: config.tms.autoSync (tests/utils/jiraSync, global.teardown); validateTestEnv; regression.yml
# Obtain: CI flag — set to "true" in GitHub secrets only if you auto-sync Xray results from CI.
# @type=boolean
AUTO_SYNC=false

# Atlassian account email. Offered at day-0; needed once the Jira host is set (scripts, Xray CLI and the Jira-Direct TMS provider read it over REST). Never a blocker: a missing one is a doctor warning.
# Used by: scripts/sync-jira-*, scripts/check-jira-setup, cli/xray (REST); config.tms.jira.user (only when the atlassian-url switch is on)
# @type=email @docs(https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_EMAIL=

# Atlassian API token. Offered at day-0; needed once the Jira host is set (scripts, Xray CLI and the Jira-Direct TMS provider read it over REST). Never a blocker: a missing one is a doctor warning. Sensitive.
# Used by: scripts/sync-jira-*, scripts/check-jira-setup, cli/xray (REST); config.tms.jira.apiToken (only when the atlassian-url switch is on)
# @sensitive @docs(https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_API_TOKEN=

# ----------------------------------------------------------------------------
# TOOLING (scope: tooling, optional). Tools that can get their credential
# elsewhere: a CI-only notifier, the private report portal. Never a blocker.
# Source: cli/lib/variables-manifest.ts. Order = manifest order.
# ----------------------------------------------------------------------------

# CI-only Slack webhook for notifications. Absent from .env.example historically; GitHub-only secret.
# Used by: the commented notification step of the suite workflows (opt-in)
# Obtain: Slack → Incoming Webhooks (optional CI notifications).
# @sensitive @type=url @docs(https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# Base URL of the private Test Report Portal. Its presence switches the suite workflows from GitHub Pages to the portal. GitHub-only.
# Used by: scripts/ci/publish-allure-portal (the switch: set = publish privately) (only when the portal-url switch is on)
# Obtain: URL of your deployed Test Report Portal (private hosting runbook in the regression-testing skill). Leave unset to publish on GitHub Pages.
# @type=url @example="https://reports.example.test"
PORTAL_URL=

# Project slug in the Test Report Portal. GitHub-only; needed only when PORTAL_URL is set.
# Used by: scripts/ci/publish-allure-portal (only when the portal-url switch is on)
# Obtain: project slug created with the portal's create-project script.
PORTAL_PROJECT=

# Per-project API key of the Test Report Portal. GitHub-only; needed only when PORTAL_URL is set. Sensitive.
# Used by: scripts/ci/publish-allure-portal (only when the portal-url switch is on)
# Obtain: per-project key printed once by the portal's create-project script.
# @sensitive
PORTAL_API_KEY=

# Cloudflare R2 account id for the report bucket. GitHub-only; needed only when PORTAL_URL is set.
# Used by: scripts/ci/publish-allure-portal (S3-compatible sync to R2) (only when the portal-url switch is on)
# Obtain: Cloudflare account id (bunx wrangler whoami).
R2_ACCOUNT_ID=

# Cloudflare R2 access key id. GitHub-only; needed only when PORTAL_URL is set. Sensitive.
# Used by: scripts/ci/publish-allure-portal (S3-compatible sync to R2) (only when the portal-url switch is on)
# Obtain: id of the R2 API token created for the report bucket.
# @sensitive
R2_ACCESS_KEY_ID=

# Cloudflare R2 secret access key. GitHub-only; needed only when PORTAL_URL is set. Sensitive.
# Used by: scripts/ci/publish-allure-portal (S3-compatible sync to R2) (only when the portal-url switch is on)
# Obtain: SHA-256 of the R2 API token value (see the private hosting runbook).
# @sensitive
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 bucket for the reports. GitHub-only; needed only when PORTAL_URL is set.
# Used by: scripts/ci/publish-allure-portal (S3-compatible sync to R2) (only when the portal-url switch is on)
# Obtain: name of the R2 bucket that holds the reports.
R2_BUCKET=

# ----------------------------------------------------------------------------
# PROJECT-UNDER-TEST (scope: project, optional). Typed EXAMPLES: the login,
# the database and the API of the app you test. Rename or delete them when
# you adapt the framework; the consumer that reads one fails by name. To
# require one in YOUR project, re-declare it in .env.schema with @required:
# an importing file may strengthen any item except TEST_ENV.
# Source: cli/lib/variables-manifest.ts. Order = manifest order.
# ----------------------------------------------------------------------------

# Local test user email (project-under-test example: rename or delete when adapting). Read by config.testUser, which fails by name when empty. CI secret in the suite workflows.
# Used by: config.testUser (config/variables.ts) -> tests/setup/ui-auth.setup, api-auth.setup, scripts/api-login
# Obtain: test-user creds for your project-under-test; set when adapting the framework to your project.
# @type=email @example="qa.local@example.test"
LOCAL_USER_EMAIL=

# Local test user password (project-under-test example: rename or delete when adapting). Read by config.testUser, which fails by name when empty. CI secret in the suite workflows.
# Used by: config.testUser (config/variables.ts) -> tests/setup/ui-auth.setup, api-auth.setup, scripts/api-login
# Obtain: test-user creds for your project-under-test; set when adapting the framework to your project.
# @sensitive
LOCAL_USER_PASSWORD=

# Staging test user email (project-under-test example: rename or delete when adapting). Read by config.testUser, which fails by name when empty. CI secret in the suite workflows.
# Used by: config.testUser (config/variables.ts) -> tests/setup/ui-auth.setup, api-auth.setup, scripts/api-login
# Obtain: test-user creds for your project-under-test; set when adapting the framework to your project.
# @type=email @example="qa.staging@example.test"
STAGING_USER_EMAIL=

# Staging test user password (project-under-test example: rename or delete when adapting). Read by config.testUser, which fails by name when empty. CI secret in the suite workflows.
# Used by: config.testUser (config/variables.ts) -> tests/setup/ui-auth.setup, api-auth.setup, scripts/api-login
# Obtain: test-user creds for your project-under-test; set when adapting the framework to your project.
# @sensitive
STAGING_USER_PASSWORD=

# Backend API base URL for OpenAPI MCP exploration. Local only.
# Used by: openapi MCP request base; curl execution after bun run api:login
# Obtain: your project-under-test API base URL — set when adapting the framework.
# @type=url @example="http://localhost:3000"
API_BASE_URL=

# Path/URL to the OpenAPI spec for the OpenAPI MCP. Local only.
# Used by: openapi MCP (schema read-only)
# Obtain: path/URL to your project OpenAPI spec — set when adapting the framework.
# @example="./api/openapi.json"
OPENAPI_SPEC_PATH=

# DBHub MCP driver (sqlserver | postgres | mysql | sqlite | mariadb). Local only.
# Used by: dbhub MCP via dbhub.toml interpolation
# Obtain: your project DB driver (sqlserver | postgres | mysql | sqlite | mariadb) — set when adapting the framework.
# @type=enum(sqlserver, postgres, mysql, sqlite, mariadb)
DBHUB_TYPE=

# DBHub MCP host. Local only.
# Used by: dbhub MCP via dbhub.toml interpolation
# Obtain: your project DB connection — set when adapting the framework.
DBHUB_HOST=

# DBHub MCP port. Local only.
# Used by: dbhub MCP via dbhub.toml interpolation
# Obtain: your project DB connection — set when adapting the framework.
# @type=port @example="5432"
DBHUB_PORT=

# DBHub MCP database name. Local only.
# Used by: dbhub MCP via dbhub.toml interpolation
# Obtain: your project DB connection — set when adapting the framework.
DBHUB_DATABASE=

# DBHub MCP user. Local only.
# Used by: dbhub MCP via dbhub.toml interpolation
# Obtain: your project DB connection — set when adapting the framework.
DBHUB_USER=

# DBHub MCP password. Local only; sensitive.
# Used by: dbhub MCP via dbhub.toml interpolation
# Obtain: your project DB connection — set when adapting the framework.
# @sensitive
DBHUB_PASSWORD=

# ----------------------------------------------------------------------------
# Optional runtime knobs. Never collected by the installer; the runtime reads
# each one with a default. Declared so an uncommented line in .env validates.
# ----------------------------------------------------------------------------

# Run browsers headless. Read by playwright.config through config.browser.headless.
# @type=boolean
HEADLESS=true

# Default action/request timeout in milliseconds (playwright.config, ApiBase).
# @type=number
DEFAULT_TIMEOUT=30000

# Capture a screenshot when a test fails (playwright.config).
# @type=boolean
SCREENSHOT_ON_FAILURE=true

# Record video when a test fails; CI only (playwright.config).
# @type=boolean
VIDEO_ON_FAILURE=true

# Where Allure raw results are written (playwright.config).
ALLURE_RESULTS_DIR=./allure-results

# Which TMS the results write-back targets (tests/utils/jiraSync.ts). Modality jira-native = jira.
# @type=enum(xray, jira, none)
TMS_PROVIDER=xray

# Default project key for bun run jira:sync-issues; falls back to .agents/project.yaml.
JIRA_PROJECT_KEY=

# Output directory for synced issues (default .context/PBI).
JIRA_SYNC_OUTPUT=

# Default sprint selector for pull --sprint (active | current | closed | >=N | 7,8,10).
JIRA_SYNC_SPRINTS=

# Default csv of optional coverable work-type slugs added to pull (improvement,tech-story,tech-debt).
JIRA_SYNC_TYPES=

# Jira-Direct TMS provider override for the run-status custom field; empty = resolve from .agents/jira-fields.json.
JIRA_TEST_STATUS_FIELD=

# Set by GitHub Actions. Read as env.isCI (global.setup, KataReporter).
# @type=boolean
CI=

# Set by GitHub Actions. Read as env.buildId (jiraSync).
BUILD_ID=

# ----------------------------------------------------------------------------
# RETIRED keys. Nothing reads them any more. Declared (optional) only so a .env
# copied from an older template still validates: delete the line from yours.
# ----------------------------------------------------------------------------

# Retired 2026-09-24: web search runs at harness level now (a connector or a user-scope MCP); nothing in the repo reads it.
# @sensitive
TAVILY_API_KEY=

# Retired 2026-09-24: the Postman MCP runs at harness level now; nothing in the repo reads it.
# @sensitive
POSTMAN_API_KEY=

# Retired 2026-09-24: the resend CLI logs in on its own (resend login); nothing in the repo reads it.
# @sensitive
RESEND_API_KEY=

# Retired 2026-09-24: legacy; bun run api:login writes the curl token to .auth/tokens.env.
# @sensitive
API_TOKEN=
