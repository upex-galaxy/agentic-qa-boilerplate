{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{TAVILY_API_KEY}}"
      },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest",
        "--caps",
        "vision,pdf,testing,tracing,tabs",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "30000",
        "--viewport-size",
        "1920x1080"
      ],
      "enabled": false
    },
    "atlassian": {
      "type": "local",
      "command": ["bunx", "-y", "@anthropic/mcp-atlassian"],
      "environment": {
        "JIRA_URL": "{{JIRA_URL}}",
        "JIRA_EMAIL": "{{JIRA_EMAIL}}",
        "JIRA_API_TOKEN": "{{JIRA_API_TOKEN}}",
        "CONFLUENCE_URL": "{{CONFLUENCE_URL}}",
        "CONFLUENCE_EMAIL": "{{CONFLUENCE_EMAIL}}",
        "CONFLUENCE_API_TOKEN": "{{CONFLUENCE_API_TOKEN}}"
      },
      "enabled": false
    },
    "dbhub": {
      "type": "local",
      "command": ["bunx", "-y", "@bytebase/dbhub@latest", "--config", "dbhub.toml"],
      "enabled": false
    },
    "openapi": {
      "type": "local",
      "command": ["bunx", "-y", "@ivotoby/openapi-mcp-server", "--tools", "dynamic"],
      "environment": {
        "API_BASE_URL": "{{API_BASE_URL}}",
        "OPENAPI_SPEC_PATH": "{{OPENAPI_SPEC_PATH}}",
        "API_HEADERS": "Authorization:Bearer {{API_TOKEN}}"
      },
      "enabled": false
    },
    "postman": {
      "type": "remote",
      "url": "https://mcp.postman.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{POSTMAN_API_KEY}}"
      },
      "enabled": false
    }
  }
}
