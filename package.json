{
  "name": "agentic-qa-boilerplate",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic QA boilerplate built on Playwright + KATA + TypeScript. Skills-based AI workflows for the full QA lifecycle — planning, manual testing, TMS docs, automation, and regression. Portable across Claude Code, Codex, Cursor, Copilot, and OpenCode.",
  "author": "UPEX Galaxy",
  "license": "MIT",
  "homepage": "https://github.com/upex-galaxy/agentic-qa-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upex-galaxy/agentic-qa-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/upex-galaxy/agentic-qa-boilerplate/issues"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "integration",
    "kata",
    "automation",
    "bun",
    "typescript",
    "boilerplate",
    "ai-driven",
    "agent-skills",
    "agentskills",
    "claude-code",
    "quality-engineering",
    "shift-left-testing",
    "agentic"
  ],
  "scripts": {
    "agents:compat": "bun scripts/agent-compatibility.ts",
    "agents:schema": "bun scripts/agents-schema.ts",
    "agents:schema:check": "bun scripts/agents-schema.ts --check",
    "agents:compat:check": "bun scripts/agent-compatibility.ts --check",
    "agents:setup": "bun scripts/agents-setup.ts",
    "allure:agent": "bun --no-env-file scripts/launch.ts --warn bunx allure agent -- bunx playwright test",
    "allure:generate": "bunx allure generate ./allure-results",
    "allure:open": "bunx allure open",
    "allure:run": "bun --no-env-file scripts/launch.ts --warn bunx allure run -- bunx playwright test",
    "allure:watch": "bunx allure watch ./allure-results",
    "api:login:local": "bun scripts/api-login.ts local",
    "api:login:staging": "bun scripts/api-login.ts staging",
    "api:login": "bun scripts/api-login.ts",
    "api:sync": "bun scripts/sync-openapi.ts",
    "context:hydrate": "bun scripts/sync-jira-issues.ts pull --include-comments",
    "context:map": "bun scripts/context-map.ts",
    "docs": "bun scripts/docs-serve.ts",
    "docs:build": "bun scripts/docs-manifest.ts",
    "docs:check": "bun scripts/lint-docs.ts",
    "env:set": "bun --no-env-file scripts/env-set.ts",
    "format:check": "prettier --check '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "format:fix": "prettier --write '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "harness:env": "bun scripts/harness-env.ts",
    "harness:env:check": "bun scripts/harness-env.ts --check",
    "instructions:check": "bun scripts/lint-instructions.ts",
    "instructions:audit": "bun scripts/instructions-audit.ts",
    "jira:check": "bun scripts/check-jira-setup.ts",
    "jira:baseline": "bun scripts/check-jira-baseline.ts",
    "jira:sync-fields": "bun scripts/sync-jira-fields.ts",
    "jira:sync-issues": "bun scripts/sync-jira-issues.ts",
    "jira:sync-link-types": "bun scripts/sync-jira-link-types.ts",
    "jira:sync-workflows": "bun scripts/sync-jira-workflows.ts",
    "jira:components": "bun scripts/sync-jira-components.ts",
    "jira:url": "bun scripts/atlassian-url.ts",
    "kata:manifest:check": "bun scripts/kata-manifest.ts --check",
    "kata:manifest:watch": "bun scripts/kata-manifest.ts --watch",
    "kata:manifest": "bun scripts/kata-manifest.ts",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "onboarding": "bun scripts/onboarding.ts",
    "prepare": "husky && bun scripts/harness-env.ts --placeholders",
    "pw:install": "playwright install --with-deps chromium",
    "repo:check": "bun run format:check && bun run lint:check && bun run types:check && bun run vars:check && bun run vars:schema:check && bun run skills:check && bun run instructions:check && bun run skills:registry:check && bun run docs:check && bun run agents:compat:check && bun run agents:schema:check && bun run kata:manifest:check && bun run vars:env:check && bun run git:policy verify",
    "repo:fix": "bun run format:fix && bun run lint:fix && bun run types:check && bun run vars:check && bun run vars:schema && bun run skills:check && bun run skills:registry:check && bun run agents:compat && bun run vars:env:check",
    "setup:doctor": "bun cli/doctor.ts",
    "setup": "bun cli/doctor.ts --preflight && bun cli/install.ts",
    "skills:check": "bun scripts/lint-skills.ts && bun scripts/lint-instructions.ts",
    "skills:evals": "bun scripts/run-skill-evals.ts",
    "skills:registry:check": "bun scripts/build-skill-registry.ts --check",
    "skills:registry": "bun scripts/build-skill-registry.ts",
    "test:clean": "rm -rf test-results playwright-report allure-results allure-report reports",
    "test:debug": "bun --no-env-file scripts/launch.ts --warn playwright test --debug",
    "test:e2e": "bun --no-env-file scripts/launch.ts --warn playwright test --project=e2e",
    "test:env:check": "bun --no-env-file scripts/launch.ts --warn bun config/validateTestEnv.ts",
    "test:headed": "bun --no-env-file scripts/launch.ts --warn playwright test --headed",
    "test:integration": "bun --no-env-file scripts/launch.ts --warn playwright test --project=integration",
    "test:last-failed": "bun --no-env-file scripts/launch.ts --warn playwright test --last-failed",
    "test:report": "playwright show-report",
    "test:retries": "bun --no-env-file scripts/launch.ts --warn playwright test --retries=2",
    "test:smoke": "bun --no-env-file scripts/launch.ts --warn playwright test --project=smoke-ui --project=smoke-api",
    "test:sync": "bun --no-env-file scripts/launch.ts --warn bun tests/utils/jiraSync.ts",
    "test:ui": "bun --no-env-file scripts/launch.ts --warn playwright test --ui",
    "tests:explain:render": "bun scripts/tests-explain-render.ts",
    "tests:map": "bun scripts/tests-map.ts",
    "test": "bun --no-env-file scripts/launch.ts --warn playwright test",
    "types:check": "tsc --noEmit",
    "up": "bun cli/update-boilerplate.ts",
    "git:policy": "bun scripts/git-policy.ts",
    "vars:check": "bun scripts/lint-vars.ts",
    "vars:env:check": "bun --no-env-file scripts/check-vars.ts",
    "worktree:provision": "bun scripts/provision-worktree.ts",
    "worktree:audit": "bun scripts/worktree-audit.ts",
    "xray": "bun cli/xray/index.ts",
    "vars:schema": "bun scripts/env-schema.ts",
    "vars:schema:check": "bun scripts/env-schema.ts --check"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@inquirer/prompts": "^8.1.0",
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "figures": "^6.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.0",
    "@faker-js/faker": "^9.8.0",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.7",
    "@types/node": "^24.10.1",
    "allure": "^3.14.1",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "varlock": "1.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css,scss,html}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
