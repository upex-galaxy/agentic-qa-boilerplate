{
  // OpenCode shared team config — committed to git.
  // Secrets are NEVER stored here, and no plaintext copy of one is written for
  // OpenCode to read. Every server that needs .env values starts through the
  // .env loader:
  //
  //   bunx -p varlock@1.20.0 varlock run --no-redact-stdout --inject vars --filter A,B -- <server>
  //
  // which reads the varlock schema plus .env / .env.local (or the secret manager
  // the schema names) from the project root at spawn time and hands the server
  // ONLY the variables in its --filter. That works however OpenCode was started:
  // a desktop or natively launched session has no process environment, and
  // `{env:VAR}` would resolve to nothing there. `--no-redact-stdout` keeps the
  // JSON-RPC stream byte-intact. The loader is the same on the three hosts
  // (MCP_ENV_LOADER_* in cli/lib/agent-compatibility-contracts.ts, ADR-0011);
  // never add `{env:}` or `{file:}` beside it: an empty value shadows .env.
  //
  // Only LOCAL (stdio) servers live here: the ones that read .env values
  // (dbhub, openapi, slack-aurora) plus context7, which needs no key and so no
  // loader. Browser automation is the playwright-cli, not an MCP. Remote servers
  // whose only project-side content was an API key (web search, Postman) are
  // connected at harness level instead: ~/.config/opencode/opencode.json for
  // OpenCode. Skills resolve them by capability, whatever the prefix
  // (.agents/instructions/agent-tool-resolution.md).
  //
  // V1 SYNTAX ON PURPOSE ("mcp", "enabled", "permission"). OpenCode 2 migrates
  // these keys on load ("mcp" -> "mcp.servers", "enabled" -> "disabled",
  // "permission" -> "permissions"), and OpenCode 1 rejects the V2 spelling, so
  // the V1 file is the one both generations read. Revisit when V1 support ends.
  //
  // Syntax notes (OpenCode-specific, different from Claude Code's .mcp.json):
  //   - env expansion is {env:VAR_NAME} (NOT ${VAR}); not used here, see above
  //   - MCP root key is "mcp"                  (NOT "mcpServers")
  //   - MCP env field is "environment"         (NOT "env")
  "$schema": "https://opencode.ai/config.json",

  // No npm plugins here. Cosmetic ones (a status line, terminal notifications)
  // are a personal choice: install them in your GLOBAL config
  // (~/.config/opencode/opencode.json), never in this shared file, where one
  // that fails to load becomes every teammate's startup warning. The repo's own
  // hook needs no entry: OpenCode loads .opencode/plugins/ automatically.

  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp@4.0.3"],
      "enabled": true
    },
    // The Slack bot MCP (Aurora). Its token and the reaction-channel allowlist
    // live in .env only; the channel ids are workspace identity and are never
    // committed. An empty SLACK_MCP_REACTION_TOOL leaves reactions off.
    "slack-aurora": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "SLACK_MCP_XOXP_TOKEN,SLACK_MCP_REACTION_TOOL",
        "--",
        "bunx",
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "environment": {
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true"
      }
    },
    // dbhub.toml reads these six through ${VAR} interpolation, but only from the
    // environment the server is LAUNCHED with: the loader's filter puts them
    // there. An EMPTY value leaves the variable empty and dbhub then fails on
    // connect rather than at startup, which reads like a database problem:
    // `bunx varlock load --agent` shows which DBHUB_* is unset, redacted. See
    // .agents/skills/agentic-qa-core/references/db-testing-doctrine.md.
    "dbhub": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "DBHUB_TYPE,DBHUB_HOST,DBHUB_PORT,DBHUB_DATABASE,DBHUB_USER,DBHUB_PASSWORD",
        "--",
        "bunx",
        "-y",
        "@bytebase/dbhub@1.2.1",
        "--config",
        "dbhub.toml"
      ],
      "enabled": true
    },
    // SCHEMA-READ-ONLY: no API_TOKEN / Authorization header is injected here.
    // The OpenAPI MCP is used ONLY to discover endpoints + read schemas
    // (list-api-endpoints, get-api-endpoint-schema). Authenticated requests are
    // executed with curl (token from `bun run api:login` → .auth/tokens.env).
    // Keeping credentials out of the MCP also removes the spawn-time restart
    // requirement for API auth. OPENAPI_SPEC_PATH may be a local file OR a URL.
    "openapi": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "API_BASE_URL,OPENAPI_SPEC_PATH",
        "--",
        "bunx",
        "-y",
        "@ivotoby/openapi-mcp-server@1.16.1",
        "--tools",
        "dynamic"
      ],
      "enabled": true
    }
  },

  // Permissions — mirrors .claude/settings.json 1:1.
  // Rule precedence: last matching pattern wins, so deny entries are placed
  // AFTER the broad allows they override (e.g. `git *` allow, then
  // `git push --force *` deny — the deny wins for force-pushes).
  //
  // Secret files (Critical Rule #1, credentials by name, never by value): the
  // `read` block and the secret entries at the end of `bash` mirror the
  // `Read(...)` / `Bash(printenv*)` denies of .claude/settings.json. Paths are
  // matched as wildcards against the full path, so `*.env` covers any depth.
  // `.env.example` and the committed `.env*.schema` files stay readable: they
  // hold names and `op://` references only.
  // `source .auth/tokens.env` keeps asking (the API doctrine sources it in the
  // same call as curl, by name); reading that file directly is denied.
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.schema": "allow",
      "*.env.*.schema": "allow",
      "*.auth/*": "deny",
      "*.claude/settings.local.json": "deny"
    },
    "bash": {
      "*": "ask",

      "bun *": "allow",
      "bunx *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "node *": "allow",

      "git *": "allow",
      "gh *": "allow",

      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "tree *": "allow",
      "test *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "curl *": "allow",

      "playwright *": "allow",
      "allure *": "allow",
      "acli *": "allow",

      "rm -rf *": "deny",
      "wget *": "deny",
      "sudo rm *": "deny",
      "sudo *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git branch -D *": "deny",
      "chmod 777 *": "deny",
      "truncate *": "deny",
      "shred *": "deny",
      "dd if=*": "deny",
      "mkfs*": "deny",

      "* .env": "deny",
      "* .env *": "deny",
      "*/.env": "deny",
      "* .env.local*": "deny",
      "* .env.*.local*": "deny",
      "* .auth/*": "deny",
      "* .claude/settings.local.json*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "varlock printenv*": "deny",
      "varlock reveal*": "deny",
      "bunx varlock printenv*": "deny",
      "bunx varlock reveal*": "deny",
      "source .auth/tokens.env": "ask",
      ". .auth/tokens.env": "ask"
    }
  }
}
